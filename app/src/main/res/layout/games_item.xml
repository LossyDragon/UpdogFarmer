<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:cardview="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="4dp"
    cardview:cardCornerRadius="4dp"
    cardview:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:background="@drawable/game_item_background"
        android:orientation="vertical"
        android:padding="8dp">

        <ImageView
            android:id="@+id/logo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/desc_game_icon"
            android:scaleType="fitCenter"
            tools:src="@drawable/ic_image_white_48dp" />

        <TextView
            android:id="@+id/name"
            style="@style/AppTheme.TextStyle.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Name Name" />

        <TextView
            android:id="@+id/hours"
            style="@style/AppTheme.TextStyle.Secondary.Small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Hours Hours" />

    </LinearLayout>

</androidx.cardview.widget.CardView>